modules = ["nodejs-24", "python-base-3.13"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"

[[ports]]
localPort = 8080
externalPort = 8080

[[ports]]
localPort = 8081
externalPort = 80

[[ports]]
localPort = 18115
externalPort = 3002

[[ports]]
localPort = 20918
externalPort = 3000

[[ports]]
localPort = 25265
externalPort = 3001

[userenv]

[userenv.shared]
VITE_CONVEX_URL = "https://majestic-giraffe-135.convex.cloud"
CONVEX_PRODUCTION_MODE = "true"
EXPO_PUBLIC_CONVEX_URL = "https://majestic-giraffe-135.convex.cloud"
